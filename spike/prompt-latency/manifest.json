{
  "manifest_version": 3,
  "name": "Cookie banner Prompt API latency spike",
  "version": "0.1",
  "description": "Throwaway spike: measures Gemini Nano (Prompt API) decision latency on cookie consent banners. Measurement only; never clicks anything.",
  "minimum_chrome_version": "138",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Cookie latency spike" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["detect.js", "engine.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
